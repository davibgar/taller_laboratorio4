    {
      "id": 11,
      "type": "timeseries",
      "title": "¿Dónde se va el tiempo de una petición? (ms promedio)",
      "description": "Suma de la duración de los spans hijos dividida entre las peticiones atendidas. La aplicación es el resto: duración del span de servidor menos los demás.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum (rate(traces_span_metrics_duration_milliseconds_sum{service_name=\"pagos-api\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])) / sum (rate(traces_span_metrics_calls_total{service_name=\"pagos-api\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])) - (sum (rate(traces_span_metrics_duration_milliseconds_sum{service_name=\"pagos-api\",span_kind=\"SPAN_KIND_CLIENT\"}[$__rate_interval])) or vector(0)) / sum (rate(traces_span_metrics_calls_total{service_name=\"pagos-api\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])) - (sum (rate(traces_span_metrics_duration_milliseconds_sum{service_name=\"pagos-api\",span_name=\"pool.acquire\"}[$__rate_interval])) or vector(0)) / sum (rate(traces_span_metrics_calls_total{service_name=\"pagos-api\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])) - (sum (rate(traces_span_metrics_duration_milliseconds_sum{service_name=\"pagos-api\",span_kind=\"SPAN_KIND_PRODUCER\"}[$__rate_interval])) or vector(0)) / sum (rate(traces_span_metrics_calls_total{service_name=\"pagos-api\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "aplicación (Python)",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum (rate(traces_span_metrics_duration_milliseconds_sum{service_name=\"pagos-api\",span_name=\"pool.acquire\"}[$__rate_interval])) or vector(0)) / sum (rate(traces_span_metrics_calls_total{service_name=\"pagos-api\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "espera por conexión del pool",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum (rate(traces_span_metrics_duration_milliseconds_sum{service_name=\"pagos-api\",span_kind=\"SPAN_KIND_CLIENT\"}[$__rate_interval])) or vector(0)) / sum (rate(traces_span_metrics_calls_total{service_name=\"pagos-api\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "consultas a MySQL",
          "range": true
        },
        {
